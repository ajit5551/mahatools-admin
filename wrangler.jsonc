{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mahatools-api",
  "main": "src_worker.js",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mahatools-db",
      "database_id": "acea169f-0aa2-4ec1-b241-16669e424668"
    }
  ]
}
